{
    "recommendations": [
        // WSL2 development (the remote pack includes WSL, SSH and Dev Containers)
        "ms-vscode-remote.vscode-remote-extensionpack",
        // official python extensions
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "astral-sh.ty",
        // official extension pack for jupyter notebooks (pandas / Spark exploration)
        "ms-toolsai.jupyter",
        // AWS: SSO profiles, S3/CloudWatch browsing, Lambda, Step Functions Workflow Studio + ASL validation
        "amazonwebservices.aws-toolkit-vscode",
        // Terraform: HCL syntax, validation, format on save, provider docs on hover
        "hashicorp.terraform",
        // containers: Postgres, Glue image, dbt image (successor to ms-azuretools.vscode-docker)
        "ms-azuretools.vscode-containers",
        // GitHub: workflow authoring + run status, PRs in the editor
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",
        "GitHub.copilot",
        // git history / blame
        "eamodio.gitlens",
        // google-docs-like real-time collaboration
        "ms-vsliveshare.vsliveshare",
        // file support: justfile, markdown/mermaid, toml, yaml, jinja
        "skellock.just",
        "yzhang.markdown-all-in-one",
        "bierner.markdown-mermaid",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml",
        "samuelcolvin.jinjahtml",
        // more detailed file icons in sidebar
        "PKief.material-icon-theme",
        // Ctrl+Alt+V / Cmd+Alt+V paste image from clipboard
        "mushan.vscode-paste-image",
        // autocompletion for file paths
        "christian-kohler.path-intellisense",
        // jump to definition of pytest fixtures
        "nickmillerdev.pytest-fixtures"
        // Added when first needed (study_plan.md §5):
        //   weeks 2-5:   "snowflake.snowflake-vsc"
        //   dbt weeks:   "innoverio.vscode-dbt-power-user", "dorzey.vscode-sqlfluff"
        //   week 9 try:  "dbtLabsInc.dbt"
    ]
}
